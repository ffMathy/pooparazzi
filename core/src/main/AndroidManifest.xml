<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Merges remote /entries/* and /settings data items into the local store (phone and watch). -->
        <service
            android:name="com.ffmathy.pooparazzi.core.sync.EntrySyncListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/entries"
                    android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:path="/settings"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
