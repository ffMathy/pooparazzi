{
  "name": "pooparazzi-firebase",
  "private": true,
  "description": "Firestore security rules of the Pooparazzi backup and families, the retention job, their tests, and the Firebase Hosting site (docs/BACKEND.md).",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore,auth --project demo-pooparazzi \"bun test ./test\"",
    "deploy": "firebase deploy --only firestore,hosting",
    "retention": "bun retention/run.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.33.0"
  }
}
