rules_version = '2';

// Pooparazzi's optional backup (docs/BACKEND.md).
//
// - Each account reads and writes only its own log, under /users/{uid}/entries.
// - Baby names are never uploaded: an entry carries an opaque baby id, and the names stay on the phone and the watch.
// - Nothing else exists, so everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // One document per log entry: its JSON (EntryJson in the app) and the server time of the write, which the app
    // pages through to fetch only what changed since its last sync. Deleting is for account deletion.
    match /users/{uid}/entries/{entryId} {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && request.resource.data.keys().hasAll(['json', 'syncedAt'])
        && request.resource.data.keys().hasOnly(['json', 'syncedAt'])
        && request.resource.data.json is string
        && request.resource.data.json.size() <= 2048
        && request.resource.data.syncedAt == request.time;
    }
  }
}
