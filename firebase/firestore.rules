rules_version = '2';

// Pooparazzi's optional backup and family sharing (docs/BACKEND.md).
//
// - Every account belongs to one family, named by /users/{uid}.familyId. A family is its members (one document per
//   account under /families/{fid}/members) and what they share: the log (entries) and the babies, names included.
// - Only members read or write a family's data. Membership is checked by the member document's existence, so every
//   request costs one extra document read.
// - A family is created by its first member, in one batch with that member's document. Anyone else joins with an
//   invite (/invites/{code}): a member makes it, the invitee joins with it within 7 days while its maker is still a
//   member, and joining deletes it.
// - The family document is never deleted: it stays behind as a tombstone when the last member leaves (with the
//   family's entries and babies deleted), so a family id is used once and nobody can create that family again and
//   take over what other members (or stale invites) still point at.
// - Every account that creates a family, joins one or invites to one has a verified email address: the member list
//   and the invites show it to others, and an unverified one could be anybody's.
// - The log of the first backup (/users/{uid}/entries) can only be read and deleted, to move it into the family.
// - There are no Cloud Functions (free Spark plan), so everything the rules cannot check is the app's job. Nothing
//   else exists, so everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function signedInAs(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The account's email address, as its sign-in token has it, has been verified (Google, or an email link).
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function familyPath(fid) {
      return /databases/$(database)/documents/families/$(fid);
    }

    function memberPath(fid, uid) {
      return /databases/$(database)/documents/families/$(fid)/members/$(uid);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    // The signed-in account is in the family (before this request).
    function isMember(fid) {
      return signedIn() && exists(memberPath(fid, request.auth.uid));
    }

    // The signed-in account is in the family once this request (a batch, say) is done.
    function isMemberAfter(fid) {
      return signedIn() && existsAfter(memberPath(fid, request.auth.uid));
    }

    // Exactly these fields, no more and no fewer.
    function hasExactly(fields) {
      return request.resource.data.keys().hasAll(fields) && request.resource.data.keys().hasOnly(fields);
    }

    // A synced document: its JSON (EntryJson or a baby's JSON in the app, at most 2 KB) and the server time of the
    // write, which the app pages through to fetch only what changed since its last sync.
    function isSyncedDoc() {
      return hasExactly(['json', 'syncedAt'])
        && request.resource.data.json is string
        && request.resource.data.json.size() <= 2048
        && request.resource.data.syncedAt == request.time;
    }

    // The account's pointer to its family. It may name only a family the account is in (also one it joins or
    // creates in the same batch). Deleting it is for account deletion.
    match /users/{uid} {
      allow get, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && hasExactly(['familyId'])
        && request.resource.data.familyId is string
        && existsAfter(memberPath(request.resource.data.familyId, uid));

      // The backup from before families: read once to move it into the family, then deleted. Never written again.
      match /entries/{entryId} {
        allow read, delete: if signedInAs(uid);
      }
    }

    match /families/{fid} {
      // Created by its first member, whose member document is created in the same batch. A family document is never
      // deleted (see the top), so this creates each family id once only.
      allow create: if verified()
        && !exists(familyPath(fid))
        && hasExactly(['createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && existsAfter(memberPath(fid, request.auth.uid));
      allow get: if isMember(fid);
      // The creator hands the family over to another member (as they leave, say): only createdBy changes, and only
      // to someone who is (still) a member once the batch is done.
      allow update: if isMember(fid)
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdBy'])
        && request.resource.data.createdBy is string
        && existsAfter(memberPath(fid, request.resource.data.createdBy));
      // Never deleted: the last member leaves by deleting the entries, the babies and their own member document.

      // Who is in the family: { email, joinedAt, invite? }. An account adds only itself, with its own verified email,
      // either as the creator of a family made in the same batch, or with an unexpired invite to this family that the
      // same batch deletes (so an invite lets one account in, once), made by someone who is still a member (so a
      // removed member's invites, and those of a family everyone left, stop working). Members are never changed. A
      // member leaves by deleting their own document; the family's creator, while a member, may remove anyone.
      match /members/{uid} {
        allow read: if isMember(fid);
        allow create: if signedInAs(uid)
          && request.resource.data.keys().hasAll(['email', 'joinedAt'])
          && request.resource.data.keys().hasOnly(['email', 'joinedAt', 'invite'])
          && verified()
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.joinedAt == request.time
          && (
            // (a) The creator of a new family.
            (!('invite' in request.resource.data)
              && !exists(familyPath(fid))
              && getAfter(familyPath(fid)).data.createdBy == uid)
            ||
            // (b) An invitee: the invite is to this family, still valid, and used up by this batch.
            (request.resource.data.get('invite', null) is string
              && get(invitePath(request.resource.data.invite)).data.familyId == fid
              && get(invitePath(request.resource.data.invite)).data.expiresAt > request.time
              && exists(familyPath(fid))
              && exists(memberPath(fid, get(invitePath(request.resource.data.invite)).data.createdBy))
              && !existsAfter(invitePath(request.resource.data.invite)))
          );
        allow delete: if signedInAs(uid)
          || (isMember(fid) && get(familyPath(fid)).data.createdBy == request.auth.uid);
      }

      // The shared log, one document per entry.
      match /entries/{entryId} {
        allow read, delete: if isMember(fid);
        allow create, update: if isMember(fid) && isSyncedDoc();
      }

      // The shared babies (id, name, updatedAtMillis), one document per baby.
      match /babies/{babyId} {
        allow read, delete: if isMember(fid);
        allow create, update: if isMember(fid) && isSyncedDoc();
      }
    }

    // An invite to a family: { familyId, createdBy, expiresAt, email? }. The code is the secret: 128 random bits,
    // URL-safe base64 (22 characters, at most 64 accepted), so any signed-in account that has the link may read it,
    // but nobody can list them. A member with a verified email makes it for their own family, valid for at most 7
    // days, optionally with their own email (shown to the invitee). It works only while its maker is a member. Deleted by whoever made it, by a member of its family, or by the
    // invitee as they join (in the joining batch).
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if verified()
        && code.size() >= 22 && code.size() <= 64
        && code.matches('[A-Za-z0-9_-]+')
        && request.resource.data.keys().hasAll(['familyId', 'createdBy', 'expiresAt'])
        && request.resource.data.keys().hasOnly(['familyId', 'createdBy', 'expiresAt', 'email'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.familyId is string
        && isMember(request.resource.data.familyId)
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd')
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email);
      allow delete: if signedIn()
        && (resource.data.createdBy == request.auth.uid
          || isMember(resource.data.familyId)
          || isMemberAfter(resource.data.familyId));
    }
  }
}
