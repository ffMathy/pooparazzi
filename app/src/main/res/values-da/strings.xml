    <!-- Samtykket før den første upload -->
    <string name="consent_title">Tag backup i Google Firebase?</string>
    <string name="consent_intro">Du er logget ind som %1$s. Der er ikke uploadet noget endnu. Før der bliver det, skal du sige ja til dette:</string>
    <string name="consent_what_title">Hvad der uploades</string>
    <string name="consent_what">Din log (måltider, bleer og søvn), dine børns navne og din e-mailadresse. En log som denne kan sige noget om dit barns helbred.</string>
    <string name="consent_who_title">Hvem der ser det</string>
    <string name="consent_who">Du og medlemmerne af din familie: alle i den ser familiens log, børnenes navne og medlemmernes e-mailadresser.</string>
    <string name="consent_where_title">Hvor</string>
    <string name="consent_where">Google Firebase. Databasen ligger i EU; Google behandler den for os og bruger den ikke til andet.</string>
    <string name="consent_withdraw_title">Hvis du fortryder</string>
    <string name="consent_withdraw">Log ud for ikke at uploade mere, forlad familien, eller slet din konto (Indstillinger › Konto) for at slette det gemte.</string>
