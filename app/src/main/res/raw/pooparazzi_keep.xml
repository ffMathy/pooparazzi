<?xml version="1.0" encoding="utf-8"?>
<!--
    Resource shrinking (release builds) keeps these although no code refers to them by R field: the Google services
    plugin generates them from app/google-services.json only when the file exists, so FirebaseConfig looks them up by
    name. Without default_web_client_id a release build would hide "Continue with Google". Names that a build without
    the file does not have are ignored.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/default_web_client_id,@string/google_app_id" />
