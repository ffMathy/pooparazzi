<?xml version="1.0" encoding="utf-8"?>
<!--
    Phone-app strings. Shared words (kinds, feed types, sides, actions, receipts, guards, units, relative phrases,
    sync lines) come from :core (com.ffmathy.pooparazzi.core.R). Danish twins live in values-da/strings.xml.
    Pure format strings that only join localised parts are not translatable.
-->
<resources>
    <string name="app_name" translatable="false">Pooparazzi</string>

    <!-- Content descriptions (DESIGN_SPEC §9.4) -->
    <string name="cd_back">Back</string>
    <string name="cd_close">Close</string>
    <string name="cd_edit_start_time">Edit start time</string>
    <!-- Name of the checked sleep toggle: the visible label plus what a tap does -->
    <string name="cd_woke_up_end_sleep">Woke up, end sleep</string>

    <!-- Lamp before the first feed is logged -->
    <string name="lamp_no_feed">No feeds yet</string>
    <!-- Hero placeholder before the first feed (a dash, not a number) -->
    <string name="lamp_no_feed_hero" translatable="false">–</string>

    <!-- Joins of localised parts -->
    <!-- Since-row lead: "Awake 1h 05m", "Pee 48m ago", "Last fed 1h 32m ago" -->
    <string name="join_space" translatable="false">%1$s %2$s</string>
    <!-- Sheet titles: "Diaper · 14:32", "Feed · 14:32" -->
    <string name="join_dot" translatable="false">%1$s · %2$s</string>
    <!-- TalkBack, two parts: "Last fed, No feeds yet" -->
    <string name="spoken_pair" translatable="false">%1$s, %2$s</string>
    <!-- TalkBack, running Lamp: "Asleep, 1 hour 7 minutes, since 02:05" -->
    <string name="spoken_running" translatable="false">%1$s, %2$s, %3$s</string>
    <!-- TalkBack, last entry: "Last feed, formula, 2 hours 10 minutes ago, at 12:22" -->
    <string name="spoken_last_entry" translatable="false">%1$s, %2$s, %3$s, %4$s</string>
    <!-- TalkBack, status since: "Awake 1 hour 5 minutes, since 13:27" -->
    <string name="spoken_status_since" translatable="false">%1$s %2$s, %3$s</string>
    <!-- TalkBack, Today grid: "Today: 5 feeds, 4 pee, 2 poop, 7 hours 57 minutes sleep" -->
    <string name="spoken_today" translatable="false">%1$s: %2$s %3$s, %4$s %5$s, %6$s %7$s, %8$s %9$s</string>


    <!-- TalkBack: "12:40 to 13:27" -->
    <string name="spoken_range">%1$s to %2$s</string>
    <!-- TalkBack names where the visible text reads badly ("+", "→") -->
    <string name="spoken_pee_and_poop">Pee and poop</string>
    <string name="spoken_side_left_then_right">left then right</string>
    <string name="spoken_side_right_then_left">right then left</string>
    <!-- TalkBack, the place of a ticked side checkbox: "Left, first, checkbox, checked" -->
    <string name="spoken_side_first">first</string>
    <string name="spoken_side_second">second</string>

    <string name="action_ok">OK</string>

    <!-- History (P3) -->
    <string name="history_previous_day">Previous day</string>
    <string name="history_next_day">Next day</string>
    <string name="history_add_entry">Add entry</string>
    <string name="history_empty">Nothing logged on this day.</string>
    <!-- Custom accessibility action on a History row (DESIGN_SPEC §9.4) -->
    <string name="action_edit_time">Edit time</string>

    <!-- Edit sheet (P4) -->
    <string name="edit_title_sleep">Edit sleep</string>
    <string name="edit_title_feed">Edit feed</string>
    <string name="edit_title_diaper">Edit diaper</string>
    <string name="edit_title_add">Add past entry</string>
    <string name="edit_fell_asleep">Fell asleep</string>
    <string name="edit_time">Time</string>
    <string name="edit_type">Type</string>
    <string name="edit_side">Side</string>
    <string name="edit_still_asleep">Still asleep</string>
    <string name="edit_end_now">End now</string>
    <!-- "Duration 52m" -->
    <string name="edit_duration">Duration %1$s</string>
    <!-- "was 12:40", "was 47m" -->
    <string name="edit_was">was %1$s</string>
    <string name="edit_earlier_date">Earlier date…</string>
    <!-- Click labels and TalkBack names -->
    <string name="edit_change_time">Change time</string>
    <string name="edit_change_day">Change day</string>
    <!-- "Fell asleep day, Today" -->
    <string name="edit_spoken_day">%1$s day, %2$s</string>
    <!-- Validation slot. %1$s is a clock time. -->
    <string name="edit_error_wake_before_sleep">Waking up must come after falling asleep.</string>
    <string name="edit_error_future">%1$s hasn\'t happened yet. Log it for yesterday?</string>
    <string name="edit_use_yesterday">Use yesterday</string>
    <string name="edit_warning_overlap_sleep">Overlaps the %1$s sleep. Save anyway?</string>
    <string name="edit_error_save_failed">Couldn\'t save this change. Try again.</string>
    <!-- The entry changed on the watch while the sheet was open: the sheet shows the merged version -->
    <string name="edit_notice_changed_on_watch">Changed on the watch meanwhile. Check and save again.</string>
    <string name="edit_error_deleted_on_watch">Deleted on the watch meanwhile.</string>

    <!-- Settings -->
    <string name="settings_section_baby">Baby</string>
    <string name="settings_appearance_hint">Auto uses Night in the evening and at night, while a sleep runs, and when the phone is in dark theme.</string>
    <string name="settings_section_watch">Watch</string>
    <string name="settings_sync_now">Sync now</string>
    <string name="settings_sync_unavailable">No watch connected. Everything is saved on this phone.</string>
    <string name="settings_section_about">About</string>
    <!-- "Version 0.1.0" -->
    <string name="settings_version">Version %1$s</string>
    <string name="settings_font_licences">Font licences</string>
    <string name="settings_font_licences_summary">Google Sans Flex and Atkinson Hyperlegible Next, SIL Open Font License 1.1</string>
    <!-- Home-screen widgets (P5, DESIGN_SPEC §3.3.6) -->
    <string name="widget_log_name">Log and status</string>
    <string name="widget_log_description">Log diapers and sleep with one tap, and see the latest feed and diaper</string>
    <string name="widget_quick_name">Feed and sleep</string>
    <string name="widget_quick_description">Feed and the sleep toggle</string>
    <!-- TalkBack names of the widget buttons -->
    <string name="widget_cd_log_feed">Log feed</string>
    <string name="widget_cd_log_pee">Log pee</string>
    <string name="widget_cd_log_poop">Log poop</string>
    <string name="widget_cd_log_both">Log pee and poop</string>
    <!-- TalkBack names of Undo in the widget receipt -->
    <string name="widget_undo_pee">Undo pee</string>
    <string name="widget_undo_poop">Undo poop</string>
    <string name="widget_undo_both">Undo pee and poop</string>
    <string name="widget_undo_sleep_start">Undo sleep start</string>
    <string name="widget_undo_woke_up">Undo woke up</string>
    <string name="widget_undo_sleep_cancelled">Undo sleep cancelled</string>

    <!-- Ongoing notification of a running sleep (P6, DESIGN_SPEC §3.3.7). %1$s is the baby's name. -->
    <string name="notification_channel_timers">Sleep in progress</string>
    <string name="notification_channel_timers_description">Shows a running sleep, with Woke up</string>
    <string name="notification_asleep_title">%1$s is asleep</string>
    <!-- "Since 02:05". %1$s is a clock time. -->
    <string name="notification_since">Since %1$s</string>
    <!-- Metric label (Android 17), followed by a clock time -->
    <string name="notification_metric_since">Since</string>
    <!-- Settings › Notifications (DESIGN_SPEC §10.5) -->
    <string name="settings_section_notifications">Notifications</string>
    <string name="settings_live_updates">Live Updates</string>
    <string name="settings_live_updates_summary">Show a running sleep in the status bar and on the lock screen</string>
    <string name="settings_notifications">Notification settings</string>
    <string name="settings_notifications_summary">A running sleep shows a notification with Woke up</string>
    <string name="settings_notifications_off">Notifications are off</string>
    <string name="settings_notifications_off_summary">Turn them on to see a running sleep outside the app</string>
</resources>
