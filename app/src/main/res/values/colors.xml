<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed colours for the system surfaces drawn before Compose (DESIGN_SPEC §3.3.8, §5.6). Night twins in values-night. -->
<resources>
    <!-- Follow the configuration's night mode: the system splash and the window behind the first frame. -->
    <color name="splash_background">#FBF6F0</color>
    <color name="splash_glyph">#3A332C</color>
    <color name="window_background">#FBF6F0</color>

    <!-- Explicit Night / Day splashes, chosen for the next launch from the app's own Appearance (API 33+). -->
    <color name="splash_night_background">#0C0A08</color>
    <color name="splash_night_glyph">#E8D8C3</color>
    <color name="splash_day_background">#FBF6F0</color>
    <color name="splash_day_glyph">#3A332C</color>

    <!-- Launcher icon: the parchment diaper glyph on the night background (amber would mean FEED). -->
    <color name="launcher_background">#0C0A08</color>
    <color name="launcher_glyph">#E8D8C3</color>

    <!-- Static widget previews for the picker on Android 12-14 (res/layout/widget_*_preview.xml): the Day widget palette, Night twins in values-night. -->
    <color name="widget_preview_surface">#F0E6DA</color>
    <color name="widget_preview_feed_c">#FFE1C4</color>
    <color name="widget_preview_feed_s">#A35F1A</color>
    <color name="widget_preview_feed_on">#452300</color>
    <color name="widget_preview_diaper_c">#CFEDE6</color>
    <color name="widget_preview_diaper_s">#24665C</color>
    <color name="widget_preview_diaper_on">#0F3D36</color>
    <color name="widget_preview_sleep_c">#E1E4F8</color>
    <color name="widget_preview_sleep_s">#37418A</color>
    <color name="widget_preview_sleep_on">#1B2152</color>
</resources>
