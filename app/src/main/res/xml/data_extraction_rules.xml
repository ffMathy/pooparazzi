<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-to-device transfer (API 31+). The log and the settings travel; the device-local flags of the
    system surfaces do not: the widget previews must be published again on the new phone, the notification
    permission is that phone's own, the widget memo and dismissed timers describe this phone's widgets and
    notifications (see SurfacePrefs, WidgetMemo), and a new phone shows the account Welcome again (WelcomePrefs) and asks
    for the backup's consent again when the parent signs in there (ConsentPrefs).

    The settings hold the babies' names, which never leave the parent's own devices (BABIES_AND_BACKUP §1): they are
    left out of the cloud backup, while a transfer from the old phone to the new one may carry them. The backup's
    bookkeeping (its cursor and account) describes this phone's sync and goes nowhere: a new phone starts its own.
    Keep in step with backup_rules_legacy.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="system_surfaces.xml" />
        <exclude domain="sharedpref" path="widget_memo.xml" />
        <exclude domain="sharedpref" path="account_welcome.xml" />
        <exclude domain="sharedpref" path="backup_consent.xml" />
        <exclude domain="file" path="datastore/pooparazzi_settings.preferences_pb" />
        <exclude domain="file" path="datastore/pooparazzi_cloud.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="system_surfaces.xml" />
        <exclude domain="sharedpref" path="widget_memo.xml" />
        <exclude domain="sharedpref" path="account_welcome.xml" />
        <exclude domain="sharedpref" path="backup_consent.xml" />
        <exclude domain="file" path="datastore/pooparazzi_cloud.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
