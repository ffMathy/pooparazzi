<?xml version="1.0" encoding="utf-8"?>
<!--
    Watch-only strings. Shared words (glossary, units, relative phrases, receipts, sync lines) come from :core
    (com.ffmathy.pooparazzi.core.R) and are not redefined here. Every string has a Danish twin in values-da.
-->
<resources>
    <string name="app_name" translatable="false">Pooparazzi</string>

    <!-- Main: idle status block before the first feed is logged -->
    <string name="status_no_feed_yet">No feeds yet</string>
    <string name="status_no_diaper_yet">No diapers yet</string>

    <!-- Pinned EdgeButton guard (DESIGN_SPEC §3.5.2): two centred lines, so keep the line break. -->
    <string name="edge_guard_already_asleep">Already\nasleep</string>
    <string name="edge_guard_already_awake">Already\nawake</string>

    <!-- TalkBack name of the running-sleep EdgeButton (DESIGN_SPEC §9.4) -->
    <string name="cd_woke_up_end_sleep">Woke up, end sleep</string>
    <!-- Click label of status cards and Today rows: they open Adjust -->

    <!-- Logged -->
    <string name="logged_already_logged">Already logged</string>
    <!-- TalkBack name of the full-screen dismiss target behind the Logged confirmation -->
    <string name="logged_dismiss">Dismiss</string>

    <!-- Adjust: group headers for the start and end of a completed interval. %1$s is a clock time. -->

    <!-- Today -->
    <!-- OpenOnPhoneDialog curved text -->
    <!-- Failure confirmation when the phone could not open History (not reachable, or an old phone app) -->

    <!-- ===== Spoken forms (TalkBack, DESIGN_SPEC §9.4–9.5): never arrows, "+" or dashes ===== -->
    <!-- Breast sides with an order, read without the arrow ("Left → Right") -->
    <string name="spoken_side_left_then_right">Left then right</string>
    <string name="spoken_side_right_then_left">Right then left</string>
    <!-- Both diaper flags, read without the plus sign ("Pee + poop") -->
    <string name="spoken_pee_and_poop">Pee and poop</string>
    <!-- A time range, read without the dash: "14:32 to 14:50". %1$s and %2$s are clock times. -->
    <string name="spoken_range">%1$s to %2$s</string>
    <!-- A range on another day: "Sun 22:40 to 01:35". %1$s weekday, %2$s spoken_range. -->
    <!-- Two spoken facts in a row: "Left then right, 18 minutes" -->
    <string name="spoken_pair">%1$s, %2$s</string>
    <!-- A status with its duration and start: "Awake 1 hour 5 minutes, since 13:27" -->
    <string name="spoken_status_since">%1$s %2$s, %3$s</string>
    <!-- A running interval read on its own: "Asleep, 1 hour 7 minutes, since 02:05" -->
    <string name="spoken_running">%1$s, %2$s, %3$s</string>
    <!-- Time since the last feed: "Last feed 2 hours 10 minutes ago". %1$s is a spoken "… ago". -->
    <string name="spoken_last_feed_ago">Last feed %1$s</string>
    <!-- A row read aloud, then what a tap does: "Pee, 13:44. Adjust" -->
    <string name="spoken_then_action">%1$s. %2$s</string>
    <!-- A status word with its start, shown and read: "Asleep since 02:05". %2$s is "since 02:05". -->
    <string name="status_since">%1$s %2$s</string>

    <!-- ===== Tile (DESIGN_SPEC §3.6, V1_ADDITIONS §2.2) ===== -->
    <string name="tile_description">Log feeds, diapers and sleep; see the time since the last feed and diaper.</string>
    <!-- Title after a tile log: "Pee 14:32" (no "at": the title chord is about 168 dp). %1$s label, %2$s clock time. -->
    <string name="tile_title_logged" translatable="false">%1$s %2$s</string>
    <!-- Title while a sleep runs: "Asleep 1h 07m". %1$s is a duration. -->
    <string name="tile_title_asleep">Asleep %1$s</string>
    <!-- Title idle without a baby name: the last diaper, kind first: "Pee 48m ago". %1$s Pee/Poop/Both, %2$s "48m ago". -->
    <string name="tile_title_last_diaper" translatable="false">%1$s %2$s</string>
    <!-- Guard titles (one line on the tile) -->
    <string name="tile_guard_already_asleep">Already asleep</string>
    <string name="tile_guard_already_awake">Already awake</string>
    <!-- TalkBack -->
    <string name="tile_cd_logged">%1$s. Tap the tile to undo</string>
    <string name="tile_cd_last_diaper">Last diaper, %1$s, %2$s</string>
    <string name="tile_cd_asleep">Asleep, %1$s</string>
    <!-- Row A. %1$s is spoken time since the last feed ("2 hours 10 minutes ago"). -->
    <string name="tile_cd_feed">Feed. Last feed %1$s</string>
    <string name="tile_cd_feed_none">Feed. No feeds yet</string>
    <string name="tile_cd_diaper">Diaper. Last diaper %1$s</string>
    <string name="tile_cd_diaper_none">Diaper. No diapers yet</string>

    <!-- ===== Complications (DESIGN_SPEC §3.7) ===== -->
    <string name="complication_since_feed">Since last feed</string>
    <string name="complication_last_diaper">Last diaper</string>
    <string name="complication_sleep">Asleep or awake</string>
    <string name="complication_sleep_long">Sleep and last feed</string>
    <!-- Shown when there is nothing to count from yet -->
    <string name="complication_no_value" translatable="false">--</string>
    <!-- LONG_TEXT: "Awake 1h 05m" / "Asleep 1h 07m". %1$s is a duration. -->
    <string name="complication_awake_for">Awake %1$s</string>
    <string name="complication_asleep_for">Asleep %1$s</string>
    <!-- LONG_TEXT title while asleep: "Fed 1h 32m ago". %1$s is "1h 32m ago". -->
    <string name="complication_fed_ago">Fed %1$s</string>
    <!-- TalkBack. %1$s is a spoken duration, %2$s a clock time. -->
    <string name="complication_cd_awake">Awake %1$s, since %2$s</string>
    <string name="complication_cd_asleep">Asleep %1$s, since %2$s</string>
    <string name="complication_cd_no_feed">No feeds yet</string>
    <string name="complication_cd_no_diaper">No diapers yet</string>
    <string name="complication_cd_no_sleep">No sleep yet</string>
    <!-- The screenshot of complication data on a neutral face (not a real watch face) -->
    <string name="complication_preview_caption">Complication data preview</string>

    <!-- ===== Ongoing Activity (DESIGN_SPEC §3.8, §10.6) ===== -->
    <string name="ongoing_channel_name">Running timers</string>
    <string name="ongoing_channel_description">Shows a running sleep on the watch face.</string>
    <!-- "Asleep since 02:05" (no ticking duration). Keep the #start# token: the system fills it in. -->
    <string name="ongoing_asleep_since">Asleep since #start#</string>
    <!-- TalkBack, the place of a ticked side checkbox: "Left, first, checkbox, checked" -->
    <string name="spoken_side_first">first</string>
    <string name="spoken_side_second">second</string>
</resources>
